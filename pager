#!/usr/bin/env python3
import sys
import argparse
import Paginacao

def ler_arquivo(caminho_arquivo: str):
    lista_execucoes = []
    try:
        with open(caminho_arquivo, 'r') as trace:
            for linha in trace:
                linha = linha.strip()
                if linha:
                    lista_execucoes.append(int(linha))
        return lista_execucoes
    except FileNotFoundError:
        print(f"Erro: Arquivo '{caminho_arquivo}' não encontrado!")
        sys.exit(1)
    except ValueError:
        print("Erro: O arquivo contém dados inválidos.")
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(description='Simulador de Paginação')
    parser.add_argument('--algo', required=True, type=str, help='Algoritmo (fifo, lru, otimo)')
    parser.add_argument('--frames', required=True, type=int, help='Número de molduras')
    parser.add_argument('--trace', required=True, type=str, help='Arquivo de trace')
    parser.add_argument('--verbose', action='store_true', help='Detalhes')
    args = parser.parse_args()

    execucoes = ler_arquivo(args.trace)

    mapa_estrategias = {
        'fifo': Paginacao.fifo,
        'lru': Paginacao.lru,
        'otimo': Paginacao.otimo
    }

    nome_algo = args.algo.lower()
    
    if nome_algo not in mapa_estrategias:
        print(f"Erro: Algoritmo '{nome_algo}' não implementado.")
        print("Opções disponíveis:", ", ".join(mapa_estrategias.keys()))
        sys.exit(1)

    funcao_escolhida = mapa_estrategias[nome_algo]

    faltas, trocas, conjunto_residente = Paginacao.paginacao(
        execucoes, 
        args.frames, 
        funcao_escolhida
    )

    print(f"Algoritmo: {nome_algo.upper()}")
    print(f"Frames: {args.frames}")
    print(f"Referências: {len(execucoes)}")
    print(f"Faltas de página: {faltas}")
    
    if len(execucoes) > 0:
        print(f"Taxa de faltas: {(faltas/len(execucoes))*100:.2f}%")
        
    print(f"Evicções (Trocas): {trocas}")

    print("Conjunto residente final:")
    print("frame_ids:", end=" ")
    for i in range(len(conjunto_residente)):
        print(f"{i}", end=" " if i < len(conjunto_residente)-1 else "\n")
    
    print("page_ids: ", end=" ")
    for i, pagina in enumerate(conjunto_residente):
        print(f"{pagina}", end=" " if i < len(conjunto_residente)-1 else "\n")

if __name__ == "__main__":
    main()